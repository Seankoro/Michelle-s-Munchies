# Copy to .env.local and fill in. Names only here, never commit real values.

# Supabase (project Settings -> API). The two public keys are enough to browse
# the menu; the service-role key is required for checkout, orders, and admin.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin access. Comma-separated emails allowed into /admin, enforced in
# middleware and every admin server action.
ADMIN_EMAILS=

# The public site URL, no trailing slash. Used in emails and links.
NEXT_PUBLIC_SITE_URL=

# WhatsApp orders. Digits only with country code, e.g. 6591234567. This is the
# confirm-and-PayNow channel; without it customers see a fallback message.
WHATSAPP_NUMBER=

# Contact page links. Blank hides the email card and unlinkifies Instagram.
CONTACT_EMAIL=
INSTAGRAM_HANDLE=

# Resend email. In production the from address must be on a verified domain,
# e.g. Michelle's Munchies <hello@michelles-munchies.com>.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
OWNER_NOTIFICATION_EMAIL=

# Cron. Bearer token for /api/cron, called hourly by an external scheduler.
# Runs abandoned-cart reminders, birthday rewards, and drop notifications.
CRON_SECRET=

# Stripe, optional. Checkout works without it via WhatsApp + PayNow.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Upstash Redis, optional. Shared rate limiting across serverless instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry error tracking, optional. The DSN is public by design; blank disables
# reporting entirely.
NEXT_PUBLIC_SENTRY_DSN=
